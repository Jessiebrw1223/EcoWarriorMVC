@{
    ViewData["Title"] = "Retos";
    ViewData["IsDashboard"] = true;
    var correoUsuario = Context.Session.GetString("UsuarioCorreo") ?? "";
    var puntosUsuario = Context.Session.GetString("UsuarioPuntos") ?? "0";
}

<section class="dashboard-shell">
    <aside class="dashboard-sidebar">
        <div>
            <div class="brand-mark">EcoWarrior</div>
            <nav class="side-nav">
                <a class="side-link" asp-controller="Home" asp-action="Index">Panel</a>
                <a class="side-link active" asp-controller="Home" asp-action="Retos">Retos</a>
                <a class="side-link" asp-controller="Home" asp-action="Ranking">Ranking</a>
                <a class="side-link" asp-controller="Home" asp-action="Perfil">Perfil</a>
            </nav>
            <form asp-controller="Home" asp-action="CerrarSesion" method="post" class="logout-form">
                @Html.AntiForgeryToken()
                <button type="submit" class="logout-btn">Cerrar sesión</button>
            </form>
        </div>
    </aside>

    <div class="dashboard-main">
        <header class="dashboard-header">
            <div class="dashboard-subtitle">Retos Ecológicos</div>
            <div class="dashboard-user">
                <div class="user-points">
                    <span>ECO WARRIOR</span>
                    <strong id="header-puntos">… pts</strong>
                </div>
                <div>
                    <strong>@ViewData["NombreUsuario"]</strong>
                    <small>@ViewData["UsernameUsuario"]</small>
                </div>
                <div class="avatar-pill">@ViewData["InicialesUsuario"]</div>
            </div>
        </header>

        <main class="retos-content">
            <section class="retos-hero">
                <div>
                    <h2>Desafíos de la Semana</h2>
                    <p>Únete a la comunidad EcoWarrior y transforma Lima un paso a la vez. Gana puntos y desbloquea insignias exclusivas.</p>
                </div>
                <div class="retos-hero-badge" aria-hidden="true"></div>
            </section>

            <!-- Filtro por categoría -->
            <div style="display:flex;gap:.5rem;flex-wrap:wrap;margin-bottom:1.25rem;">
                <button class="filtro-btn active" data-cat="todos">Todos</button>
                <button class="filtro-btn" data-cat="Reciclaje">♻️ Reciclaje</button>
                <button class="filtro-btn" data-cat="Movilidad">🚲 Movilidad</button>
                <button class="filtro-btn" data-cat="Naturaleza">🌱 Naturaleza</button>
                <button class="filtro-btn" data-cat="Comunidad">🧹 Comunidad</button>
                <button class="filtro-btn" data-cat="AhorroAgua">💧 Agua</button>
                <button class="filtro-btn" data-cat="Alimentacion">🥗 Alimentación</button>
            </div>

            <!-- Carga dinámica -->
            <div id="retos-loading" style="text-align:center;padding:2rem;color:#888;">
                🌱 Cargando retos...
            </div>
            <section class="retos-grid" id="retos-grid" style="display:none;"></section>
        </main>
    </div>
</section>

<!-- Modal confirmación -->
<div id="modal-overlay" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:1000;align-items:center;justify-content:center;">
    <div style="background:#fff;border-radius:16px;padding:2rem;max-width:380px;width:90%;text-align:center;box-shadow:0 20px 60px rgba(0,0,0,.25);">
        <div style="font-size:2.5rem;margin-bottom:.5rem;" id="modal-emoji">🌱</div>
        <h3 id="modal-titulo" style="margin:.25rem 0;">Confirmar Reto</h3>
        <p id="modal-desc" style="color:#666;font-size:.9rem;margin:.5rem 0 1.25rem;"></p>
        <p style="font-weight:700;color:#2dbf72;font-size:1.1rem;" id="modal-puntos"></p>
        <div style="display:flex;gap:.75rem;margin-top:1.25rem;">
            <button id="modal-cancelar" style="flex:1;padding:.65rem;border:2px solid #ddd;border-radius:10px;background:#fff;cursor:pointer;font-weight:600;">Cancelar</button>
            <button id="modal-confirmar" style="flex:1;padding:.65rem;border:none;border-radius:10px;background:linear-gradient(90deg,#36cf7c,#29b565);color:#fff;cursor:pointer;font-weight:700;">¡Completar!</button>
        </div>
    </div>
</div>

<!-- Toast -->
<div id="eco-toast" style="display:none;position:fixed;bottom:1.5rem;right:1.5rem;background:#1a5c35;color:#fff;padding:.75rem 1.25rem;border-radius:12px;font-weight:600;z-index:9999;box-shadow:0 4px 20px rgba(0,0,0,.2);max-width:300px;"></div>

@section Scripts {
<style>
.filtro-btn{padding:.4rem 1rem;border-radius:999px;border:2px solid #d0dbd5;background:#fff;color:#536160;font-weight:600;cursor:pointer;font-size:.82rem;transition:all .2s;}
.filtro-btn.active,.filtro-btn:hover{background:linear-gradient(90deg,#36cf7c,#29b565);color:#fff;border-color:transparent;}
.reto-card-v2{background:#fff;border-radius:16px;padding:1.25rem;box-shadow:0 2px 12px rgba(0,0,0,.06);display:flex;flex-direction:column;gap:.6rem;transition:transform .2s,box-shadow .2s;}
.reto-card-v2:hover{transform:translateY(-2px);box-shadow:0 6px 22px rgba(0,0,0,.1);}
.reto-completado-overlay{opacity:.55;pointer-events:none;}
.btn-completar{margin-top:auto;padding:.6rem 1rem;border:none;border-radius:10px;background:linear-gradient(90deg,#36cf7c,#29b565);color:#fff;font-weight:700;cursor:pointer;font-size:.9rem;transition:filter .2s;}
.btn-completar:hover{filter:brightness(1.08);}
.btn-ya-completado{margin-top:auto;padding:.6rem 1rem;border:none;border-radius:10px;background:#e8f5e9;color:#2e7d32;font-weight:700;font-size:.9rem;}
.dif-easy{background:#d4edda;color:#155724;}.dif-media{background:#fff3cd;color:#856404;}.dif-alta{background:#f8d7da;color:#721c24;}
.dif-chip{padding:.2rem .65rem;border-radius:999px;font-size:.75rem;font-weight:700;}
</style>
<script>
const CORREO = '@Html.Raw(correoUsuario)';
let todosLosRetos = [];
let retosCompletadosLocal = new Set();
let retoParaConfirmar = null;

function mostrarToast(msg, color='#1a5c35'){
    const t=document.getElementById('eco-toast');
    t.textContent=msg; t.style.background=color; t.style.display='block';
    setTimeout(()=>t.style.display='none',3500);
}

function difColor(d){return d==='Fácil'||d==='Easy'?'dif-easy':d==='Alta'||d==='Hard'?'dif-alta':'dif-media';}

function renderRetos(retos){
    const grid=document.getElementById('retos-grid');
    grid.innerHTML='';
    if(!retos.length){
        grid.innerHTML='<p style="color:#aaa;grid-column:1/-1;text-align:center;padding:2rem;">No hay retos en esta categoría.</p>';
        return;
    }
    retos.forEach(r=>{
        const completado = retosCompletadosLocal.has(r.id);
        const card=document.createElement('article');
        card.className='reto-card-v2'+(completado?' reto-completado-overlay':'');
        card.innerHTML=`
            <div style="display:flex;justify-content:space-between;align-items:center;">
                <span style="font-size:1.8rem;">${r.iconoEmoji||'🌱'}</span>
                <span class="dif-chip ${difColor(r.dificultad)}">${r.dificultad}</span>
            </div>
            <h3 style="margin:.25rem 0;font-size:1rem;">${r.titulo}</h3>
            <p style="color:#667;font-size:.85rem;flex:1;">${r.descripcion}</p>
            <div style="display:flex;justify-content:space-between;align-items:center;margin-top:.25rem;">
                <strong style="color:#2dbf72;">+ ${r.puntos} pts</strong>
                <span style="font-size:.78rem;color:#aaa;">${r.categoria}</span>
            </div>
            ${completado
                ? `<button class="btn-ya-completado">✅ ¡Completado!</button>`
                : `<button class="btn-completar" data-id="${r.id}">Completar Reto</button>`
            }
        `;
        if(!completado){
            card.querySelector('.btn-completar').addEventListener('click',()=>abrirModal(r));
        }
        grid.appendChild(card);
    });
}

async function cargarRetos(){
    try{
        const resp=await fetch('/api/home/retos');
        todosLosRetos=await resp.json();
        // cargar perfil para saber cuáles completó
        if(CORREO){
            const pr=await fetch(`/api/home/perfil?correo=${encodeURIComponent(CORREO)}`);
            if(pr.ok){
                const perfil=await pr.json();
                document.getElementById('header-puntos').textContent=`${perfil.puntos.toLocaleString()} pts`;
            }
        }
        document.getElementById('retos-loading').style.display='none';
        document.getElementById('retos-grid').style.display='grid';
        renderRetos(todosLosRetos);
    }catch(e){
        document.getElementById('retos-loading').textContent='⚠️ Error cargando retos. Intenta recargar la página.';
    }
}

// Filtros
document.querySelectorAll('.filtro-btn').forEach(btn=>{
    btn.addEventListener('click',()=>{
        document.querySelectorAll('.filtro-btn').forEach(b=>b.classList.remove('active'));
        btn.classList.add('active');
        const cat=btn.dataset.cat;
        const filtrados=cat==='todos'?todosLosRetos:todosLosRetos.filter(r=>r.categoria===cat);
        renderRetos(filtrados);
    });
});

// Modal
function abrirModal(reto){
    retoParaConfirmar=reto;
    document.getElementById('modal-emoji').textContent=reto.iconoEmoji||'🌱';
    document.getElementById('modal-titulo').textContent=reto.titulo;
    document.getElementById('modal-desc').textContent=reto.descripcion;
    document.getElementById('modal-puntos').textContent=`+ ${reto.puntos} puntos`;
    const overlay=document.getElementById('modal-overlay');
    overlay.style.display='flex';
}
document.getElementById('modal-cancelar').addEventListener('click',()=>{
    document.getElementById('modal-overlay').style.display='none';
    retoParaConfirmar=null;
});
document.getElementById('modal-confirmar').addEventListener('click',async()=>{
    if(!retoParaConfirmar) return;
    const btn=document.getElementById('modal-confirmar');
    btn.disabled=true; btn.textContent='Registrando...';
    try{
        const resp=await fetch('/api/home/completar-reto',{
            method:'POST',
            headers:{'Content-Type':'application/json','X-User-Correo':CORREO},
            body:JSON.stringify({retoId:retoParaConfirmar.id})
        });
        const data=await resp.json();
        if(resp.ok){
            retosCompletadosLocal.add(retoParaConfirmar.id);
            mostrarToast(`🎉 ${data.mensaje}`);
            // actualizar header puntos
            const pr=await fetch(`/api/home/perfil?correo=${encodeURIComponent(CORREO)}`);
            if(pr.ok){const p=await pr.json(); document.getElementById('header-puntos').textContent=`${p.puntos.toLocaleString()} pts`;}
            const cat=document.querySelector('.filtro-btn.active')?.dataset.cat||'todos';
            const lista=cat==='todos'?todosLosRetos:todosLosRetos.filter(r=>r.categoria===cat);
            renderRetos(lista);
        }else{
            mostrarToast(`⚠️ ${data.mensaje||'Error al completar reto.'}','#c0392b'`);
        }
    }catch{
        mostrarToast('⚠️ Error de conexión.','#c0392b');
    }finally{
        btn.disabled=false; btn.textContent='¡Completar!';
        document.getElementById('modal-overlay').style.display='none';
        retoParaConfirmar=null;
    }
});

cargarRetos();
</script>
}
