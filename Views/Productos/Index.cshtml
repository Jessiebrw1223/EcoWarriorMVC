@model IReadOnlyList<EcoWarriorMVC.Models.Producto>
@{
    ViewData["Title"] = "Productos";
    var categoriaActual = ViewBag.Categoria as string;
    var categorias = ViewBag.Categorias as IReadOnlyList<string> ?? Array.Empty<string>();
}

<section class="container py-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <span class="badge bg-success mb-2">Base de datos PostgreSQL</span>
            <h1 class="fw-bold mb-1">Gestión de productos sostenibles</h1>
            <p class="text-muted mb-0">Listado conectado a Entity Framework Core con operaciones CRUD.</p>
        </div>
        <a class="btn btn-success" asp-action="Crear">+ Nuevo producto</a>
    </div>

    @if (TempData["MensajeExito"] is not null)
    {
        <div class="alert alert-success">@TempData["MensajeExito"]</div>
    }
    @if (TempData["MensajeError"] is not null)
    {
        <div class="alert alert-danger">@TempData["MensajeError"]</div>
    }

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body d-flex flex-wrap gap-2 align-items-center">
            <strong class="me-2">Filtrar:</strong>
            <a class="btn btn-sm @(string.IsNullOrWhiteSpace(categoriaActual) ? "btn-success" : "btn-outline-success")" asp-action="Index">Todos</a>
            @foreach (var categoria in categorias)
            {
                <a class="btn btn-sm @(categoria == categoriaActual ? "btn-success" : "btn-outline-success")" asp-action="Index" asp-route-categoria="@categoria">@categoria</a>
            }
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-warning">No hay productos registrados para esta categoría.</div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var producto in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <article class="card h-100 border-0 shadow-sm product-card">
                        <img src="@producto.ImagenUrl" class="card-img-top" alt="@producto.Nombre" style="height:220px; object-fit:cover;" onerror="this.src='https://images.unsplash.com/photo-1542601906990-b4d3fb778b09?auto=format&fit=crop&w=1200&q=80'" />
                        <div class="card-body">
                            <div class="d-flex justify-content-between gap-2 mb-2">
                                <span class="badge bg-light text-success border">@producto.Categoria</span>
                                <span class="badge @(producto.Activo ? "bg-success" : "bg-secondary")">@(producto.Activo ? "Activo" : "Inactivo")</span>
                            </div>
                            <h5 class="card-title fw-bold">@producto.Nombre</h5>
                            <p class="card-text text-muted">@producto.Descripcion</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <strong>S/ @producto.Precio.ToString("0.00")</strong>
                                <small class="text-muted">Stock: @producto.Stock</small>
                            </div>
                        </div>
                        <div class="card-footer bg-white border-0 d-flex gap-2 flex-wrap">
                            <a class="btn btn-outline-success btn-sm" asp-action="Detalle" asp-route-id="@producto.Id">Ver</a>
                            <a class="btn btn-outline-primary btn-sm" asp-action="Editar" asp-route-id="@producto.Id">Editar</a>
                            <form asp-action="Eliminar" asp-route-id="@producto.Id" method="post" onsubmit="return confirm('¿Eliminar este producto?');">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-outline-danger btn-sm" type="submit">Eliminar</button>
                            </form>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</section>
